---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'writing'>['data'] & { slug: string };

const { title, description, published, project, repository, slug } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(published);

// Label the source link from the URL itself. Hardcoding an owner makes the
// visible text lie as soon as a project moves to another account or org.
const repositoryUrl = new URL(repository);
const repositoryLabel = `${repositoryUrl.host}${repositoryUrl.pathname.replace(/\/$/, '')}`;
---

<BaseLayout
  title={`${title} — Syntropic Systems`}
  description={description}
  ogImage={`/og/${slug}.png`}
  ogType="article"
>
  <main id="content" class="article-page">
    <article>
      <header class="article-header">
        <p class="article-kicker"><a href="/">writing</a> / {project}</p>
        <h1>{title}</h1>
        <p class="article-dek">{description}</p>
        <div class="article-byline">
          <span>Abhishek Gautam</span>
          <time datetime={published.toISOString().slice(0, 10)}>{formattedDate}</time>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="article-source">
        <span>Project source</span>
        <a href={repository} rel="noopener">{repositoryLabel} ↗</a>
      </footer>
    </article>
  </main>
</BaseLayout>
