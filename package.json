{
  "name": "syntropic-systems-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "predev": "npm run sync",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "prebuild": "npm run sync",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "precheck": "npm run sync",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "1.62.1",
    "typescript": "latest"
  }
}
